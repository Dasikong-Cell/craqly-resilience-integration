# craqly-resilience-integration — runtime configuration example
# Copy to `.env` and fill in. `.env` is git-ignored; `.env.example` is committed.

# --- LLM ---
LLM_PRIMARY_MODEL=gpt-4o
LLM_FAST_MODEL=gpt-4o-mini
LLM_MAX_TOKENS=4096
LLM_FIRST_TOKEN_BUDGET_MS=1000

# --- OCR ---
OCR_MIN_CHARS=3
OCR_ENGINE=none

# --- WebSocket ---
WS_URL=ws://localhost:8000/ws
WS_RECONNECT_MAX=5
WS_BACKOFF_BASE_MS=500

# --- Cache ---
ANSWER_CACHE_PATH=./cache/answers.json
